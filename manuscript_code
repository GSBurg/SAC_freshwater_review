## 2.2 Helper functions ----
# Missing values and the text "NA" become "Not reported"
clean_na <- function(x) {
  x <- str_trim(as.character(x))
  ifelse(is.na(x) | x == "NA", "Not reported", x)
}
# Columns with mixed numbers and text are read as lists; convert them to numbers
list_to_chr <- function(x) str_trim(map_chr(x, ~ if (is.null(.x) || length(.x) == 0) NA_character_ else as.character(.x[[1]])))
list_to_num <- function(x) suppressWarnings(as.numeric(list_to_chr(x)))


## 2.3 Clean ----
