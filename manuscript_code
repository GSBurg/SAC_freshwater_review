# Width/height ratio of each silhouette, so that wide ones are drawn smaller
get_aspect <- function(uuid) tryCatch({ img <- get_phylopic(uuid, format = "raster", height = 256); dim(img)[2] / dim(img)[1] }, error = function(e) NA_real_)
icon_aspect <- map_dbl(target_uuids, get_aspect)
