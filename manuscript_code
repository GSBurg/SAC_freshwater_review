icon_scale[c("Macroinvertebrates", "Fungi", "Microorganisms", "Periphyton", "Zooplankton")] <- c(1.2, 1.15, 1.1, 1.1, 1.2)

icon_height <- function(groups, base = 1, max_aspect = 1.2) unname(base * pmin(1, max_aspect / icon_aspect[groups]) * icon_scale[groups])
phylopic_layers <- function(d, x, y) lapply(seq_len(nrow(d)), function(i) geom_phylopic(data = d[i, ], aes(x = .data[[x]], y = .data[[y]], uuid = uuid), height = d$h[i], inherit.aes = FALSE))

## 3.8 Heatmap helpers ----
# Cell colour: hue = freshwater realm, intensity = number of analyses
shade_col <- function(hue, n, n_max, min_t = 0.3) map2_chr(hue, n, function(h, k) { if (is.na(h) || k <= 0) return(grey_na); t <- min_t + (1 - min_t) * k / n_max; colorRampPalette(c("white", h))(101)[round(t * 100) + 1] })

# Count table of two variables, with facet groups and the realm hue of each cell
heat_counts <- function(xvar, yvar, x_order, y_order, x_group, y_group, hue_from = c("y", "x")) {
  hue_from <- match.arg(hue_from)
  dat %>% count(.data[[xvar]], .data[[yvar]], name = "n") %>% rename(xcat = 1, ycat = 2) %>% complete(xcat = x_order, ycat = y_order, fill = list(n = 0)) %>% mutate(xgroup = factor(unname(x_group[xcat]), levels = unique(unname(x_group[x_order]))), ygroup = factor(unname(y_group[ycat]), levels = unique(unname(y_group[y_order])))) %>% filter(!is.na(xgroup), !is.na(ygroup)) %>% mutate(hue = unname(realm_colors[as.character(if (hue_from == "y") ygroup else xgroup)]), xcat = factor(xcat, levels = x_order), ycat = factor(ycat, levels = rev(y_order)))
}

plot_heat <- function(d, n_max, title, strip_x = FALSE, strip_y = TRUE, legend_name = "Analyses", strip_y_size = 10, y_wrap = NULL) {
  d <- d %>% mutate(cell_col = shade_col(hue, n, n_max), dark_text = n <= n_max * 0.55)
  ggplot(d, aes(x = xcat, y = ycat)) +
    geom_tile(aes(fill = cell_col), color = "white", linewidth = 0.6) +
    geom_point(data = filter(d, n > 0), aes(color = n), alpha = 0) +
    geom_text(data = filter(d, n > 0, dark_text), aes(label = n), size = 3.2, fontface = "bold", color = "grey15") +
    geom_text(data = filter(d, n > 0, !dark_text), aes(label = n), size = 3.2, fontface = "bold", color = "white") +
    scale_fill_identity() +
    scale_color_gradient(low = "grey85", high = "grey10", limits = c(1, n_max), name = legend_name) +
    facet_grid(ygroup ~ xgroup, scales = "free", space = "free", switch = "y", labeller = labeller(xgroup = wrap_group, ygroup = if (is.null(y_wrap)) label_value else label_wrap_gen(y_wrap))) +
    labs(title = title, x = NULL, y = NULL) +
    theme_heat +
    theme(strip.text.x = if (strip_x) element_text(size = 10, face = "bold") else element_blank(), strip.text.y.left = if (strip_y) element_text(angle = 0, hjust = 1, size = strip_y_size, face = "bold", lineheight = 0.9) else element_blank())
}

