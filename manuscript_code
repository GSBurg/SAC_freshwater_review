## 3.3 Plot helpers ----
# Legend inside the plot area; (x, y) = lower-left corner of the legend (0-1)
inside_legend <- function(x, y) {
  if (utils::packageVersion("ggplot2") >= "3.5.0") theme(legend.position = "inside", legend.position.inside = c(x, y), legend.justification = c(0, 0)) else theme(legend.position = c(x, y), legend.justification = c(0, 0))
}

# Take the legend out of a plot, to place it freely in a combined figure
get_legend <- function(p) {
  g <- ggplotGrob(p)
  idx <- which(grepl("guide-box", g$layout$name) & vapply(g$grobs, inherits, logical(1), "gtable"))[1]
  g$grobs[[idx]]
}

# Line breaks for long biological group names in narrow facet strips
group_strip_labels <- c("Host-associated organisms" = "Host-\nassociated\norganisms", "Fungi & microbes" = "Fungi &\nmicrobes", "Algae & plants" = "Algae &\nplants")
wrap_group <- function(x) ifelse(x %in% names(group_strip_labels), group_strip_labels[x], as.character(x))

# Hand-drawn y-axis at the left panel edge (line, ticks, labels), used by the
# UpSet plots: a regular axis would be moved away from the panel when patchwork
# aligns the panel with wider panels below it
axis_layers <- function(ylim, breaks, x0) {
  out <- list(annotate("segment", x = x0, xend = x0, y = ylim[1], yend = ylim[2], color = "grey40", linewidth = 0.5))
  if (length(breaks) > 0) out <- c(out, list(annotate("segment", x = x0 - 0.08, xend = x0, y = breaks, yend = breaks, color = "grey40", linewidth = 0.5), annotate("text", x = x0 - 0.13, y = breaks, label = breaks, hjust = 1, size = 10 / .pt, color = "grey25")))
  out
}

