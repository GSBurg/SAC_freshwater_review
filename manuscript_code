factor_levels <- c("Dispersal ability", "Barriers or fragmentation", "Organism traits", "Taxonomic identity", "Environmental heterogeneity", "Habitat type", "Seasonality", "Spatial scale", "Methodological", "Other")
factor_theme <- c("Dispersal ability" = "Dispersal &\nconnectivity", "Barriers or fragmentation" = "Dispersal &\nconnectivity", "Organism traits" = "Organism", "Taxonomic identity" = "Organism", "Environmental heterogeneity" = "Environment", "Habitat type" = "Environment", "Seasonality" = "Environment", "Spatial scale" = "Scale &\nmethods", "Methodological" = "Scale &\nmethods", "Other" = "Other")
