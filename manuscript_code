bars_part <- function(ylim, breaks) {
  d <- bar_stack %>% mutate(ymin_c = pmin(pmax(ymin, ylim[1]), ylim[2]), ymax_c = pmin(pmax(ymax, ylim[1]), ylim[2])) %>% filter(ymax_c > ymin_c)
