method_group <- function(x) {
  l <- tolower(x)
  case_when(str_detect(l, "mrm|multiple regression on distance") ~ "MRM",
            str_detect(l, "mantel") ~ "Mantel-type tests",
            str_detect(l, "decay") ~ "Distance decay",
            str_detect(l, "moran|geary|correlogram|join-count|lisa") ~ "Correlograms & autocorrelation indices",
            str_detect(l, "variogram|krig") ~ "Variograms & kriging",
            str_detect(l, "mem\\b|pcnm|aem\\b|eigenvector|spatial filter") ~ "Spatial eigenvectors",
            str_detect(l, "jsdm|hmsc|joint species") ~ "Joint species distribution models",
            str_detect(l, "car\\b|sar\\b|autoregress|gls|gamm|spatial random|inla|spde|gaussian process|spatial regression") ~ "Spatial regression models",
            TRUE ~ "Other")
}
