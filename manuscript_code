# Objectives are grouped by keywords (check printed mapping in 6.2)
objective_group <- function(x) {
  l <- tolower(x)
  case_when(str_detect(l, "non-?independ|independ|account|control|correct|residual|nuisance") ~ "Account for non-independence", str_detect(l, "infer|process|mechanis") ~ "Infer processes", str_detect(l, "predict|forecast|interpol|krig|map") ~ "Predict spatial patterns", str_detect(l, "detect|describ|quantif|characteri|structure|pattern|range|scale|test") ~ "Detect spatial structure", TRUE ~ "Other")
}
objective_levels <- c("Detect spatial structure", "Infer processes", "Account for non-independence", "Predict spatial patterns", "Other")

process_levels <- c("Dispersal limitation", "Species sorting or environmental filtering", "Mass effects", "Biotic interactions", "Neutral or stochastic processes", "Historical processes")
# Rare factors merged into broader classes
