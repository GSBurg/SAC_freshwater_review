## 8.2 Plot function ----
build_method_metric_upset <- function(sets_tbl, metric_tbl, set_order, metric_order, title, max_combos = 15, label_map = NULL, metric_label_map = NULL, heat_low = "#F8F1EE", heat_high = "#9E2F1F", bar_fill = "#4A4A4A", show_heat_labels = TRUE) {
  cn <- sets_tbl %>% mutate(key = combo_key(sets)) %>% count(key, name = "n") %>% arrange(desc(n)) %>% slice_head(n = max_combos) %>% mutate(x = row_number())
  k <- nrow(cn); xl <- c(0.4, k + 0.6)
  ylow <- c(0, ceiling(cn$n[min(2, k)] * 1.25 / 10) * 10)
  brk <- k >= 2 && cn$n[1] > ylow[2] * 1.5
  if (!brk) ylow <- c(0, ceiling(cn$n[1] * 1.1 / 10) * 10)
  yhigh <- c(floor(cn$n[1] * 0.93 / 10) * 10, ceiling(cn$n[1] * 1.05 / 10) * 10)

  bar_part <- function(yl, breaks) {
    d <- cn %>% mutate(a = pmin(pmax(0, yl[1]), yl[2]), b = pmin(pmax(n, yl[1]), yl[2])) %>% filter(b > a)
    ggplot(d) + geom_rect(aes(xmin = x - 0.35, xmax = x + 0.35, ymin = a, ymax = b), fill = bar_fill, color = "white", linewidth = 0.3) + axis_layers(yl, breaks, xl[1]) + scale_x_continuous(limits = xl, oob = scales::oob_keep, expand = c(0, 0)) + scale_y_continuous(limits = yl, breaks = breaks, expand = c(0, 0)) + coord_cartesian(clip = "off") + theme_review + theme(axis.text = element_blank(), axis.title = element_blank(), axis.ticks = element_blank(), axis.line = element_blank(), panel.grid.major.x = element_blank(), panel.grid.minor = element_blank())
  }
  slash <- function(y, yl) annotate("segment", x = xl[1] - 0.18, xend = xl[1] + 0.18, y = y - 0.06 * diff(yl), yend = y + 0.06 * diff(yl), color = "grey25", linewidth = 0.7)
  ttl <- element_text(size = 15, face = "bold", margin = margin(b = 10))
  lb <- pretty(ylow, n = 5); lb <- lb[lb >= ylow[1] & lb <= ylow[2]]
  low <- bar_part(ylow, lb) + geom_text(data = filter(cn, n <= ylow[2]), aes(x = x, y = n, label = n), inherit.aes = FALSE, vjust = -0.4, size = 3.4, fontface = "bold", color = "grey20") + annotate("text", x = xl[1] - 0.75, y = mean(ylow), label = "Number of analyses", angle = 90, size = 12 / .pt, fontface = "bold", color = "grey15") + theme(plot.margin = margin(t = 2, b = 0))
  if (brk) {
    hb <- pretty(yhigh, n = 2); hb <- hb[hb > yhigh[1] & hb < yhigh[2]]
    low <- low + slash(ylow[2], ylow)
    high <- bar_part(yhigh, hb) + geom_text(data = filter(cn, n > ylow[2]), aes(x = x, y = n, label = n), inherit.aes = FALSE, vjust = -0.4, size = 3.4, fontface = "bold", color = "grey20") + slash(yhigh[1], yhigh) + labs(title = title) + theme(plot.margin = margin(b = 2), panel.grid.major.y = element_blank(), plot.title.position = "plot", plot.title = ttl)
  } else low <- low + labs(title = title) + theme(plot.title.position = "plot", plot.title = ttl)

  row_combo <- sets_tbl %>% mutate(key = combo_key(sets)) %>% filter(key %in% cn$key) %>% left_join(select(cn, key, x, combo_n = n), by = "key")
  heat_counts <- row_combo %>% select(row_id, key, x, combo_n) %>% left_join(metric_tbl, by = "row_id") %>% distinct(row_id, key, x, combo_n, metric) %>% count(key, x, combo_n, metric, name = "metric_n") %>% mutate(pct = 100 * metric_n / combo_n)
  heat_df <- expand_grid(x = 1:k, metric = metric_order) %>% left_join(select(cn, x, key, combo_n = n), by = "x") %>% left_join(select(heat_counts, key, metric, metric_n, pct), by = c("key", "metric")) %>% mutate(metric_n = replace_na(metric_n, 0L), pct = replace_na(pct, 0), y = match(metric, rev(metric_order)))
  metric_rows <- rev(metric_order)
  metric_row_labels <- if (is.null(metric_label_map)) metric_rows else ifelse(metric_rows %in% names(metric_label_map), metric_label_map[metric_rows], metric_rows)
  heat <- ggplot(heat_df, aes(x = x, y = y, fill = pct)) + geom_tile(color = "white", linewidth = 0.7, width = 0.88, height = 0.88) + {if (show_heat_labels) geom_text(aes(label = ifelse(metric_n == 0, "", paste0(round(pct), "%"))), size = 2.7, color = "grey15", fontface = "bold")} + geom_text(data = tibble(y = seq_along(metric_rows), label = metric_row_labels), aes(x = xl[1] - 0.1, y = y, label = label), inherit.aes = FALSE, hjust = 1, size = 11 / .pt, fontface = "bold", color = "grey10", lineheight = 0.9) + scale_fill_gradient(low = heat_low, high = heat_high, limits = c(0, 100)) + scale_x_continuous(limits = xl, oob = scales::oob_keep, expand = c(0, 0)) + scale_y_continuous(limits = c(0.5, length(metric_rows) + 0.5), expand = c(0, 0)) + coord_cartesian(clip = "off") + theme_review + theme(axis.text = element_blank(), axis.title = element_blank(), axis.ticks = element_blank(), panel.grid.major = element_blank(), panel.grid.minor = element_blank(), plot.margin = margin(t = 5, b = 5), legend.position = "none")

  shown_methods <- unique(unlist(strsplit(cn$key, " + ", fixed = TRUE)))
  rows <- rev(set_order[set_order %in% shown_methods])
  md <- expand_grid(x = 1:k, set = rows) %>% left_join(select(cn, x, key), by = "x") %>% mutate(member = map2_lgl(set, key, ~ .x %in% strsplit(.y, " + ", fixed = TRUE)[[1]]), y = match(set, rows))
  ml <- md %>% filter(member) %>% group_by(x) %>% summarise(ymin = min(y), ymax = max(y), .groups = "drop") %>% filter(ymin < ymax)
  row_labels <- if (is.null(label_map)) rows else ifelse(rows %in% names(label_map), label_map[rows], rows)
  mat <- ggplot(md, aes(x = x, y = y)) + geom_point(data = filter(md, !member), color = "grey88", size = 3.8) + geom_segment(data = ml, aes(x = x, xend = x, y = ymin, yend = ymax), inherit.aes = FALSE, linewidth = 1.1, color = "grey15", lineend = "round") + geom_point(data = filter(md, member), color = "grey15", size = 3.8) + geom_text(data = tibble(y = seq_along(rows), label = row_labels), aes(x = xl[1] - 0.1, y = y, label = label), inherit.aes = FALSE, hjust = 1, size = 12 / .pt, fontface = "bold", color = "grey10", lineheight = 0.9) + scale_x_continuous(limits = xl, oob = scales::oob_keep, expand = c(0, 0)) + scale_y_continuous(limits = c(0.5, length(rows) + 0.5), expand = c(0, 0)) + coord_cartesian(clip = "off") + theme_review + theme(axis.text = element_blank(), axis.title = element_blank(), axis.ticks = element_blank(), panel.grid.major = element_blank(), panel.grid.minor = element_blank(), plot.margin = margin(t = 2))

  parts <- if (brk) list(high, low, heat, mat) else list(low, heat, mat)
  heights <- if (brk) c(0.18, 1, 0.12 * length(metric_rows), 0.11 * length(rows)) else c(1, 0.12 * length(metric_rows), 0.11 * length(rows))
  list(parts = parts, heights = heights, combos_shown = k, combos_total = n_distinct(combo_key(sets_tbl$sets)), analyses_shown = sum(cn$n), analyses_total = nrow(sets_tbl), methods_shown = rev(rows))
}

