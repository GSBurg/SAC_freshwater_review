## 6.7 Permutation function ----

run_factor_process_perm <- function(n_perm = 9999, seed = 123) {
  ids <- intersect(unique(factor_perm_long$Analysis_ID), unique(process_perm_long$Analysis_ID))
  n_analysis <- length(ids)
  message(n_analysis, " eligible analyses")

  F <- matrix(0L, nrow = n_analysis, ncol = length(factor_perm_levels), dimnames = list(ids, factor_perm_levels))
  factor_sub <- factor_perm_long %>% filter(Analysis_ID %in% ids, Factor_affecting_SAC %in% factor_perm_levels) %>% distinct(Analysis_ID, Factor_affecting_SAC)
  F[cbind(match(factor_sub$Analysis_ID, ids), match(factor_sub$Factor_affecting_SAC, factor_perm_levels))] <- 1L

  P <- matrix(0L, nrow = n_analysis, ncol = length(process_perm_levels), dimnames = list(ids, process_perm_levels))
  process_sub <- process_perm_long %>% filter(Analysis_ID %in% ids, Process_inferred %in% process_perm_levels) %>% distinct(Analysis_ID, Process_inferred)
  P[cbind(match(process_sub$Analysis_ID, ids), match(process_sub$Process_inferred, process_perm_levels))] <- 1L

  stopifnot(nrow(F) == nrow(P), identical(rownames(F), rownames(P)), nrow(F) == n_analysis)
  observed <- t(F) %*% P
  expected <- outer(colSums(F), colSums(P)) / n_analysis
  dimnames(expected) <- dimnames(observed)

  perm_sum <- matrix(0, nrow(observed), ncol(observed), dimnames = dimnames(observed))
  perm_sumsq <- matrix(0, nrow(observed), ncol(observed), dimnames = dimnames(observed))
  extreme_count <- matrix(0, nrow(observed), ncol(observed), dimnames = dimnames(observed))
  valid <- expected > 0
  global_obs <- sum(((observed[valid] - expected[valid])^2) / expected[valid])
  global_extreme <- 0L

  set.seed(seed)
  for (i in seq_len(n_perm)) {
    P_perm <- P[sample.int(n_analysis, n_analysis, replace = FALSE), , drop = FALSE]
    perm_mat <- t(F) %*% P_perm
    perm_sum <- perm_sum + perm_mat
    perm_sumsq <- perm_sumsq + perm_mat^2
    extreme_count <- extreme_count + (abs(perm_mat - expected) >= abs(observed - expected))
    global_perm <- sum(((perm_mat[valid] - expected[valid])^2) / expected[valid])
    global_extreme <- global_extreme + as.integer(global_perm >= global_obs)
  }

  null_mean <- perm_sum / n_perm
  null_var <- (perm_sumsq - n_perm * null_mean^2) / (n_perm - 1)
  null_sd <- sqrt(pmax(null_var, 0))
  SES <- (observed - null_mean) / null_sd
  SES[null_sd == 0] <- NA_real_
  p_mat <- (extreme_count + 1) / (n_perm + 1)

  matrix_long <- function(x, value_name) {
    as.data.frame(as.table(x)) %>% as_tibble() %>% rename(Factor_affecting_SAC = Var1, Process_inferred = Var2, !!value_name := Freq)
  }

  result <- matrix_long(observed, "observed") %>%
    left_join(matrix_long(expected, "expected"), by = c("Factor_affecting_SAC", "Process_inferred")) %>%
    left_join(matrix_long(null_mean, "null_mean"), by = c("Factor_affecting_SAC", "Process_inferred")) %>%
    left_join(matrix_long(null_sd, "null_sd"), by = c("Factor_affecting_SAC", "Process_inferred")) %>%
    left_join(matrix_long(SES, "SES"), by = c("Factor_affecting_SAC", "Process_inferred")) %>%
    left_join(matrix_long(p_mat, "p_value"), by = c("Factor_affecting_SAC", "Process_inferred"))

  factor_n <- tibble(Factor_affecting_SAC = factor_perm_levels, factor_n = as.numeric(colSums(F)))
  process_n <- tibble(Process_inferred = process_perm_levels, process_n = as.numeric(colSums(P)))

  result <- result %>%
    left_join(factor_n, by = "Factor_affecting_SAC") %>%
    left_join(process_n, by = "Process_inferred") %>%
    mutate(p_adj = p.adjust(p_value, method = "BH"),
           direction = case_when(SES > 0 ~ "More frequent than expected", SES < 0 ~ "Less frequent than expected", TRUE ~ "As expected"),
           factor_support = case_when(factor_n >= 10 ~ "Good support (>=10 analyses)", factor_n >= 5 ~ "Sparse support (5-9 analyses)", TRUE ~ "Very sparse support (<5 analyses)")) %>%
    arrange(p_adj, desc(abs(SES)))

  list(n_analysis = n_analysis, factor_matrix = F, process_matrix = P, observed = observed, expected = expected,
       global_statistic = global_obs, global_p = (global_extreme + 1) / (n_perm + 1), pairwise = result)
}

